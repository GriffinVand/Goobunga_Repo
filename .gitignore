# =============================================================================
# Unreal Engine
# =============================================================================
 
# Build results
Binaries/
Build/
 
# Unreal Engine generated files
Intermediate/
Saved/
DerivedDataCache/
 
# Compiled source files
*.pdb
 
# Unreal automation tool
AutomationTool/
 
# Crash reports
Crashes/
 
# Packed/staged builds
Packaged/
StagedBuilds/
*.pak
 
# Unreal file diffs
*.patch
 
# Shader intermediate files
*.ushaderbytecode
*.upipelinecache
 
# Backup files created by the editor
*.bak
Backup/
 
# Config files that contain user-specific settings
Saved/Config/
 
 
# =============================================================================
# JetBrains Rider
# =============================================================================
 
# Rider project files
.idea/
 
# User-specific files
*.user
*.suo
 
# Rider / ReSharper
_ReSharper*/
*.ReSharper
*.DotSettings.user
 
# Rider workspace and local history
.idea/.idea.*/workspace.xml
.idea/.idea.*/tasks.xml
.idea/.idea.*/usage.statistics.xml
.idea/.idea.*/shelf/
.idea/.idea.*/.idea/
 
 
# =============================================================================
# Visual Studio (generated by UBT / sometimes alongside Rider)
# =============================================================================
 
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
.vs/
 
 
# =============================================================================
# OS & misc
# =============================================================================
 
# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
 
# macOS
.DS_Store
.AppleDouble
.LSOverride
 
# Linux
*~
 
# Logs
*.log
 